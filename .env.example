VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Web Push VAPID public key — safe to expose client-side (that's the point
# of the public/private split). The private key is an Edge Function secret
# only (supabase secrets set VAPID_PRIVATE_KEY=...), never here.
VITE_VAPID_PUBLIC_KEY=

# Playwright E2E fixture account — pre-confirmed via admin API, reused across
# all authenticated E2E specs (test-only, never used for real usage).
PLAYWRIGHT_TEST_EMAIL=e2e-fixture@fitness-app.test
PLAYWRIGHT_TEST_PASSWORD=

# Second fixture account, only for friends.spec.ts (needs two real,
# independently-authenticated users to exercise a request/accept flow).
PLAYWRIGHT_TEST_EMAIL_2=e2e-fixture-2@fitness-app.test
PLAYWRIGHT_TEST_PASSWORD_2=
